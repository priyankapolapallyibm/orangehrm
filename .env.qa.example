COMPOSE_PROJECT_NAME=peopleflow-qa
NODE_ENV=production
JWT_SECRET=replace-with-a-qa-secret-at-least-32-characters
DEMO_ADMIN_USERNAME=admin.qa
DEMO_ADMIN_PASSWORD=replace-with-a-qa-password
WEB_ORIGIN=https://qa.peopleflow.local
API_UPSTREAM=http://api:3000
DATABASE_URL=file:/data/peopleflow.db
QA_WEB_PORT=8081
QA_DATA_VOLUME=peopleflow-qa-data
